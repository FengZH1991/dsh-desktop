{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "edit|write|pptd_write_file|str_replace",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/pre-edit-snapshot.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/focus-chain.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
